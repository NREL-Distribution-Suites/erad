lt_fragility_curves import DEFAULT_FRAGILTY_CURVES\n\n# Generate synthetic assets\nN = 1000\nnp.random.seed(42)\n\nengine = SimulationEngine()\nengine.load_assets_from_arrays(\n    asset_ids=[str(uuid4()) for _ in range(N)],\n    asset_names=[f'pole_{i}' for i in range(N)],\n    asset_types=np.full(N, 6, dtype=np.int32),\n    asset_type_names=['distribution_poles'] * N,\n    latitudes=36.0 + np.random.random(N),\n    longitudes=-121.0 + np.random.random(N),\n    heights_m=np.full(N, 10.0),\n)\n\n# Create hazard system\neq = EarthQuakeModel(\n    name='eq1', timestamp=datetime(2024, 1, 1),\n    origin=Point(-120.5, 36.5), depth=Distance(15, 'km'), magnitude=5.5\n)\nhs = HazardSystem(name='demo')\nhs.add_component(eq)\n\nengine.load_hazards(hs)\nengine.load_fragility_curves(DEFAULT_FRAGILTY_CURVES)\nengine._loaded = True\nengine.run()\n\ndf = engine.export_to_dataframe()\nprint(f'Computed {len(df):,} records')\nprint(f'Mean survival: {df[\"survival_probability\"].mean():.4f}')\ndf.head()","key":"jE6rd2D1wj"},{"type":"outputs","id":"PTgjXA5glmKa5o2ntWRsK","children":[],"key":"Vhg7s7lOBi"}],"key":"ED9F5dfxoL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Conversion Utilities","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CJjsM2nzfP"}],"identifier":"conversion-utilities","label":"Conversion Utilities","html_id":"conversion-utilities","implicit":true,"key":"pES19Sl3HV"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Convert between Pydantic models and DuckDB engine in either direction:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bfjsQ3Zvus"}],"key":"K1EBZsQiUS"}],"key":"AubghUIA5a"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"valu